{
  "window.nativeTabs": false,
  "editor.formatOnSave": false,
  "[json]": {
    "editor.defaultFormatter" : "j-brooke.fracturedjsonvsc",
    "editor.formatOnSave"     : true,
    "editor.tabSize"          : 2,
    "editor.insertSpaces"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "[jsonc]": {
    "editor.defaultFormatter" : "j-brooke.fracturedjsonvsc",
    "editor.formatOnSave"     : true,
    "editor.tabSize"          : 2,
    "editor.insertSpaces"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "[jsonl]": {
    "editor.defaultFormatter" : "j-brooke.fracturedjsonvsc",
    "editor.formatOnSave"     : true,
    "editor.tabSize"          : 2,
    "editor.insertSpaces"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "[xml]": {
    "editor.defaultFormatter" : "redhat.vscode-xml",
    "editor.formatOnSave"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "[lua]": {
    "editor.defaultFormatter" : "sumneko.lua",
    "editor.formatOnSave"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "[yaml]": {
    "editor.defaultFormatter" : "thegeeklab.yamlfmt-ng",
    "editor.formatOnSave"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "[toml]": {
    "editor.defaultFormatter" : "tombi-toml.tombi",
    "editor.formatOnSave"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "[markdown]": {
    "editor.defaultFormatter" : "charliermarsh.ruff",
    "editor.formatOnSave"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "[python]": {
    "editor.defaultFormatter" : "charliermarsh.ruff",
    "editor.formatOnPaste"    : true,
    "editor.formatOnSave"     : true,
    "editor.showUnused"       : true,
    "editor.codeActionsOnSave": {
      "source.fixAll.pylance"      : "always",
      "source.fixAll.ruff"         : "never",
      "source.fixAll.ty"           : "always",
      "source.organizeImports.ruff": "always"
    }
  },
  "[dockercompose]": {
    "editor.defaultFormatter" : "ms-azuretools.vscode-containers",
    "editor.formatOnSave"     : true,
    "editor.codeActionsOnSave": {"source.fixAll": "always"}
  },
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.ignore": ["*interactive*"],
  "ruff.enable": true,
  "ruff.nativeServer": "auto",
  "python.analysis.indexing": false,
  "python.analysis.importFormat": "absolute",
  "python.analysis.inlayHints.callArgumentNames": "off",
  "python.languageServer": "Default",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.languageServerMode": "default",
  "python.terminal.useEnvFile": true,
  "python.analysis.autoFormatStrings": true,
  "python.analysis.disableTaggedHints": true,
  "python.analysis.logLevel": "Warning",
  "python.analysis.inlayHints.pytestParameters": false,
  "python.analysis.enableTroubleshootMissingImports": true,
  "python.analysis.completeFunctionParens": false,
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.generateWithTypeAnnotation": true,
  "python.analysis.includeAliasesFromUserFiles": true,
  "python.analysis.inlayHints.functionReturnTypes": false,
  "python.analysis.autoImportCompletions": true,
  "ty.disableLanguageServices": true,
  "ty.completions.autoImport": true,
  "ty.diagnosticMode": "openFilesOnly",
  "ty.inlayHints.callArgumentNames": false,
  "ty.inlayHints.variableTypes": false,
  "pyrefly.commentFoldingRanges": true,
  "python.pyrefly.typeCheckingMode": "auto",
  "python.pyrefly.disableLanguageServices": false,
  "python.pyrefly.disableTypeErrors": false,
  "python.pyrefly.runnableCodeLens": true,
  "python.pyrefly.streamDiagnostics": true,
  "python.pyrefly.syncNotebooks": true,
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "jupyter.enableKernelCompletions": false,
  "jupyter.askForKernelRestart": false,
  "jupyter.interactiveWindow.creationMode": "single",
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "interactiveWindow.executeWithShiftEnter": true,
  "oxc.enable.oxfmt": true,
  "oxc.enable.oxlint": true,
  "oxc.enable": true,
  "workbench.editor.mouseBackForwardToNavigate": true,
  "search.followSymlinks": false,
  "files.exclude": {
    "Library"           : false,
    ".cache"            : true,
    ".local"            : false,
    ".bun"              : true,
    ".cargo"            : true,
    ".npm"              : true,
    ".rustup"           : true,
    ".vscode/extensions": true,
    ".copilot"          : true,
    "**/node_modules"   : true,
    "**/.git"           : true,
    "**/.venv"          : true,
    "**/venv"           : true,
    "**/__pycache__"    : true,
    "**/.pytest_cache"  : true,
    "**/.ruff_cache"    : true,
    "**/dist"           : true,
    "**.egg-info**"     : true
  },
  "search.exclude": {
    "Library"           : true,
    "**.egg-info**"     : true,
    ".cache"            : true,
    ".local"            : false,
    ".bun"              : true,
    ".cargo"            : true,
    ".npm"              : true,
    ".rustup"           : true,
    ".vscode/extensions": true,
    ".copilot"          : true,
    "Downloads"         : true,
    "**/node_modules"   : true,
    "**/.git"           : true,
    "**/.venv"          : true,
    "**/venv"           : true,
    "**/__pycache__"    : true,
    "**/.pytest_cache"  : true,
    "**/.ruff_cache"    : true,
    "**/dist"           : true,
    "**/*.lock"         : true,
    "**/build"          : true,
    "**/coverage"       : true
  },
  "files.watcherExclude": {
    "Library/**"              : true,
    ".cache/**"               : true,
    ".local/**"               : false,
    ".bun/**"                 : true,
    ".cargo/**"               : true,
    ".npm/**"                 : true,
    ".rustup/**"              : true,
    "**.egg-info**"           : true,
    ".vscode/extensions/**"   : true,
    ".copilot/**"             : true,
    "**/node_modules/**"      : true,
    "**/.git/**"              : true,
    "**/.venv/**"             : true,
    "**/venv/**"              : true,
    "**/__pycache__/**"       : true,
    "**/.pytest_cache/**"     : true,
    "**/.ruff_cache/**"       : true,
    "**/dist/**"              : true,
    "**/.git/objects/**"      : true,
    "**/.git/subtree-cache/**": true,
    "**/build/**"             : true,
    "**/coverage/**"          : true,
    "**/.next/**"             : true,
    "**/.nuxt/**"             : true,
    "**/target/**"            : true,
    "**/*.log"                : true
  },
  "git.autoRepositoryDetection": true,
  "workbench.tree.indent": 16,
  "workbench.startupEditor": "none",
  "workbench.list.smoothScrolling": true,
  "workbench.editor.wrapTabs": true,
  "workbench.editor.pinnedTabSizing": "shrink",
  "workbench.remoteIndicator.showExtensionRecommendations": false,
  "workbench.sideBar.location": "left",
  "workbench.editor.openPositioning": "last",
  "workbench.editor.tabSizing": "shrink",
  "editor.fontSize": 14,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.secondarySideBar.showLabels": false,
  "editor.parameterHints.enabled": true,
  "editor.detectIndentation": false,
  "editor.wordWrap": "on",
  "editor.fontFamily": "MesloLGS NF",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "editor.codeActionWidget.includeNearbyQuickFixes": false,
  "editor.selectionHighlight": true,
  "editor.smoothScrolling": true,
  "editor.minimap.showSlider": "always",
  "editor.mouseWheelZoom": true,
  "editor.quickSuggestions": {"other": true, "comments": true, "strings": true},
  "editor.occurrencesHighlight": "off",
  "editor.tokenColorCustomizations": {"comments": "#C69650"},
  "editor.lineHeight": 1.8,
  "task.allowAutomaticTasks": "on",
  "git.countBadge": "off",
  "chat.viewSessions.orientation": "stacked",
  "redhat.telemetry.enabled": false,
  "explorer.confirmDragAndDrop": false,
  "remote.autoForwardPortsSource": "hybrid",
  "git.confirmSync": false,
  "diffEditor.codeLens": true,
  "git.openRepositoryInParentFolders": "never",
  "git.enableSmartCommit": true,
  "explorer.confirmPasteNative": false,
  "debug.inlineValues": "off",
  "explorer.sortOrder": "type",
  "diffEditor.hideUnchangedRegions.enabled": true,
  "window.title": "${rootName}${separator}${activeEditorShort}",
  "window.commandCenter": false,
  "terminal.integrated.initialHint": false,
  "github.copilot.selectedCompletionModel": "",
  "security.workspace.trust.untrustedFiles": "open",
  "explorer.confirmDelete": false,
  "git.autofetch": true,
  "debug.toolBarLocation": "floating",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "editor.accessibilitySupport": "off",
  "git.autofetchPeriod": 15,
  "json.schemaDownload.trustedDomains": {"*": true},
  "evenBetterToml.schema.links": true,
  "evenBetterToml.schema.associations": {},
  "evenBetterToml.formatter.alignComments": true,
  "evenBetterToml.schema.enabled": true,
  "evenBetterToml.formatter.alignEntries": true,
  "evenBetterToml.schema.catalogs": [
    "https://www.schemastore.org/api/json/catalog.json",
    "https://catalog.lintel.tools/schemas/lintel/catalog/latest.json",
    ""
  ],
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com"             : true,
    "https://github.com/microsoft/vscode/wiki/*": true
  },
  "ruff.format.preview": true,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",   "**/.github/workflows/*.yaml",  "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",   "**/.forgejo/workflows/*.yml",  "**/.forgejo/workflows/*.yaml"
  ],
  "evenBetterToml.formatter.arrayAutoCollapse": true,
  "evenBetterToml.formatter.arrayAutoExpand": true,
  "evenBetterToml.formatter.arrayTrailingComma": true,
  "evenBetterToml.formatter.columnWidth": 2,
  "evenBetterToml.formatter.allowedBlankLines": 2,
  "evenBetterToml.formatter.indentEntries": true,
  "workbench.colorTheme": "Gruvbox Dark Soft",
  "extensions.experimental.deferredStartupFinishedActivation": true,
  "scm.repositories.selectionMode": "single"
}
