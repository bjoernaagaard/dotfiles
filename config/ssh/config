# Shared SSH routing managed by mise.
# Private keys and machine-specific overrides stay out of the repository.
# SSH keys are served by the Bitwarden desktop SSH agent.
Include ~/.ssh/config.local

# --- Tailnet hosts ---
Host ws
  HostName workstation
  User bsaa
  ForwardX11 yes

Host router
  HostName 192.168.1.1
  User root

Host nas
  HostName dunewest
  User bsaa

# --- Defaults ---
Host *
  ServerAliveInterval 60
  ServerAliveCountMax 5
