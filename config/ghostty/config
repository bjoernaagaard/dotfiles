auto-update-channel = tip

font-family = Maple Mono NF
font-size = 14
theme = Material Design Colors
keybind = alt+backspace=text:\x1b\x7f
keybind = alt+¨=text:\x7e
keybind = alt+BracketRight=text:\x7e
keybind = alt+'=text:\x40
keybind = alt+Quote=text:\x40

background-opacity = 0.98
background-blur = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-width = 160
window-height = 80
window-decoration = true
window-step-resize = true

cursor-style = bar
cursor-style-blink = false
scrollback-limit = 50000000
mouse-hide-while-typing = false 
copy-on-select = clipboard
selection-word-chars = " ,│`|:\"'()[]{}<>\t"
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
macos-option-as-alt = true

shell-integration = detect
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
