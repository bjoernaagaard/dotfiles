auto-update-channel = tip

font-family = Maple Mono NF
font-size = 14
theme = Material Design Colors
keybind = alt+backspace=text:\x1b\x7f
keybind = alt+¨=text:\x7e
keybind = alt+BracketRight=text:\x7e
keybind = alt+'=text:\x40
keybind = alt+Quote=text:\x40

# Herdr-mirror bindings
keybind = ctrl+shift+super+alt+b=toggle_command_palette
keybind = ctrl+shift+super+alt+d=new_split:right
keybind = ctrl+shift+super+alt+c=new_split:down
keybind = ctrl+shift+super+alt+left=goto_split:left
keybind = ctrl+shift+super+alt+down=goto_split:down
keybind = ctrl+shift+super+alt+up=goto_split:up
keybind = ctrl+shift+super+alt+right=goto_split:right
keybind = ctrl+shift+super+alt+x=close_surface
keybind = ctrl+shift+super+alt+t=new_tab
keybind = ctrl+shift+super+alt+comma=previous_tab
keybind = ctrl+shift+super+alt+period=next_tab
keybind = ctrl+shift+super+alt+w=close_tab:this
keybind = ctrl+shift+super+alt+tab=goto_split:previous
keybind = ctrl+shift+super+alt+r=equalize_splits
keybind = ctrl+shift+super+alt+e=reload_config

background-opacity = 0.98
background-blur = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-width = 160
window-height = 80
window-decoration = true
window-step-resize = true

cursor-style = bar
cursor-style-blink = false
scrollback-limit = 50000000
mouse-hide-while-typing = false 
copy-on-select = clipboard
selection-word-chars = " ,│`|:\"'()[]{}<>\t"
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
macos-option-as-alt = true

shell-integration = detect
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
