auto-update-channel = tip
font-family = Maple Mono NF
font-size = 14
theme = Cursor Dark

keybind = cmd+shift+period=reload_config

keybind = alt+backspace=text:\x1b\x7f
keybind = alt+¨=text:\x7e
keybind = alt+BracketRight=text:\x7e
keybind = alt+'=text:\x40
keybind = alt+Quote=text:\x40

keybind = cmd+shift+p=toggle_command_palette
keybind = cmd+d=new_split:right
keybind = cmd+c=new_split:down
keybind = cmd+x=close_surface

keybind = cmd+left=goto_split:left
keybind = cmd+down=goto_split:down
keybind = cmd+up=goto_split:up
keybind = cmd+right=goto_split:right
keybind = cmd+r=equalize_splits

keybind = cmd+t=new_tab
keybind = cmd+w=close_tab:this
keybind = cmd+tab=next_tab
keybind = cmd+shift+tab=previous_tab

keybind = cmd+shift+enter=toggle_quick_terminal

focus-follows-mouse = true

background-opacity = 0.98
background-blur = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-width = 160
window-height = 80
window-decoration = true
macos-titlebar-style = tabs
window-save-state = always
window-step-resize = true

cursor-style = bar
cursor-style-blink = false
scrollback-limit = 50000000
mouse-hide-while-typing = false 
copy-on-select = clipboard
selection-word-chars = " ,│`|:\"'()[]{}<>\t"
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
macos-option-as-alt = true

shell-integration = detect
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
notify-on-command-finish = unfocused
