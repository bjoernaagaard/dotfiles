auto-update-channel = tip

font-family = PaperMono NF
font-size = 14
theme = Material Design Colors

background-opacity = 0.98
background-blur = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-width = 160
window-height = 80
window-decoration = true
window-step-resize = true

cursor-style = bar
cursor-style-blink = false
scrollback-limit = 50000000
mouse-hide-while-typing = false 
copy-on-select = clipboard
selection-word-chars = " ,│`|:\"'()[]{}<>\t"
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
macos-option-as-alt = true

# Let Herdr receive left Alt+Arrow instead of Ghostty's word-navigation defaults.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind

shell-integration = detect
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

# F11 is direct in K10 Windows mode; Fn+F11 is Volume Down.
keybind = f11=toggle_fullscreen
