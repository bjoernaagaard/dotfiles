{
  "pyrefly": { "command": ["pyrefly", "lsp"], "extensions": [".py", ".pyi"] },
  "ruff"   : { "command": ["ruff", "server"], "extensions": [".py", ".pyi"] },
  "tombi"  : { "command": ["tombi", "lsp"], "extensions": [".toml"] },
  "biome"  : {
    "command"   : ["biome", "lsp-proxy"],
    "extensions": [
      ".astro",   ".css",     ".graphql", ".gql",     ".html",    ".js",      ".jsx",     ".json",    ".jsonc",
      ".ts",      ".tsx",     ".vue"
    ]
  }
}
