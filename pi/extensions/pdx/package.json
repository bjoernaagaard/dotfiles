{
  "name": "pdx",
  "version": "0.1.0",
  "description": "Native Pi tools for pitchfork, mise, and fnox",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pitchfork",
    "mise",
    "fnox"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.5 <25"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.8 <0.81",
    "@earendil-works/pi-coding-agent": ">=0.80.8 <0.81",
    "@earendil-works/pi-tui": ">=0.80.8 <0.81",
    "typebox": ">=1.0.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.9",
    "@earendil-works/pi-coding-agent": "0.80.9",
    "@earendil-works/pi-tui": "0.80.9",
    "@types/node": "^24.0.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  }
}
