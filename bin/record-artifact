#!/usr/bin/env bash
# record-artifact — record terminal artifacts.
#
# Usage:
#   record-artifact video [seconds]   Record the screen to an .mp4 file.
#                                     Reproduce the artifact on screen.
#                                     Stop with Ctrl+C (plain terminals).
#                                     Use a fixed duration inside herdr
#                                     panes, where Ctrl+C can split the
#                                     pane instead of stopping.
#   record-artifact tty [name]        Record this shell (keys and output
#                                     bytes, with timing) to a
#                                     .typescript file. Reproduce the
#                                     artifact in this shell. Stop with:
#                                     exit
#   record-artifact replay <file>     Replay a .typescript file in real
#                                     time. An .mp4 file opens in the
#                                     default viewer.
#   record-artifact list              List the saved recordings.
#
# Storage: $ARTIFACT_DIR (default: ~/terminal-artifacts)
#
set -uo pipefail

DIR="${ARTIFACT_DIR:-$HOME/terminal-artifacts}"
mkdir -p "$DIR"

stamp() { date +%Y-%m-%dT%H-%M-%S; }

case "${1:-help}" in
  video)
    file="$DIR/$(stamp).mp4"
    if [[ -n "${2:-}" ]]; then
      echo "Recording screen for ${2}s... reproduce the artifact now."
      screencapture -v -V "$2" "$file" || true
    else
      echo "Recording screen - reproduce the artifact, then press Ctrl+C here to stop."
      echo "  (Inside a herdr pane ctrl+c may split instead of stopping;"
      echo "   if so, use: record-artifact video <seconds>)"
      screencapture -v "$file" || true
    fi
    echo "Saved: $file"
    ;;
  tty)
    name="${2:-$(stamp)}"
    file="$DIR/$name.typescript"
    echo "Recording this shell (keys + output bytes, with timing)."
    echo "Reproduce the artifact here, then stop with: exit"
    script -r -q "$file" || true
    echo "Saved: $file"
    echo "Replay: record-artifact replay $file"
    ;;
  replay)
    file="${2:-}"
    [[ -n "$file" ]] || { echo "usage: record-artifact replay <file>" >&2; exit 2; }
    case "$file" in
      *.mp4) open "$file" ;;
      *) script -p "$file" ;;
    esac
    ;;
  list)
    ls -lht "$DIR"
    ;;
  *)
    sed -n '2,21p' "$0"
    exit 2
    ;;
esac